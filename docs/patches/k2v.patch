+def k2v_candidates(
+    case: Case, V: int, comp: Sequence[int], comm: Sequence[int]
+) -> list[tuple[int, ...]]:
+    """``K=2V`` 的切点候选：把 L 层先按负载均衡切成 ``2V`` 段。
+
+    块 ``k`` 与块 ``2V-1-k`` 同属卡组 ``k``——于是每个卡组各持一块靠前的、一块靠后的，
+    这正是 DualPipe 的镜像配对。只做负载均衡（``dp_split`` 两条链一起）与均分两种，
+    因为配对本身已经把"早段 + 晚段"的负载拉平，切法再花哨收益有限。
+    """
+    if 2 * V > case.L:
+        return []
+    out: list[tuple[int, ...]] = []
+    for cuts in (
+        psi_mod.dp_split(case.L, 2 * V, comp, comm),
+        psi_mod.balanced_split(case.L, 2 * V),
+    ):
+        if cuts is None or len(cuts) != 2 * V - 1:
+            continue
+        if cuts not in out:
+            out.append(cuts)
+    return out
+
+
