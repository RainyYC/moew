  "cards": [
    {
      "dot": "cyan",
      "title": "三个职责边界",
      "items": [
        "run 在解析参数前记录计时起点，并负责输入、错误与输出。",
        "Solver::solve 编排搜索并返回完整结果；搜索模块持有候选和当前最优解。"
      ]
    },
    {
      "dot": "violet",
      "title": "参数对象、策略、适配器",
      "items": [
        "ProblemView 与 ScheduleOutput 借用已有数据；EventConfig / ListConfig 表达具名配置。",
        "策略在编译期选择；具体策略适配完整调度调用，不为每个 operation 增加虚调用。"
      ]
    },
    {
      "dot": "amber",
      "title": "同一算法模型",
      "items": [
        "事件、列表与局部搜索共用十操作 DAG 和操作值类型。",
        "局部搜索直接重排资源序列，不经过 Scheduler<Strategy>。"
      ]
    },
    {
      "dot": "cyan",
      "title": "小规模 full 的两段增强",
      "items": [
        "仅 full、非 serial、mb≤16、节点数≤8000 且 L>G 时进入额外阶段。",
        "资源下界布局搜索最多占用 2.0 秒，累计截止 6.1 秒；优先级搜索最多 1.6 秒，累计截止 7.8 秒。",
        "通过共同 validator 的严格改进才更新 best；最终 polish 仍受入口后 9.2 秒目标约束。"
      ]
    }
  ]
