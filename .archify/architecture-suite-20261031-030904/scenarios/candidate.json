  "cards": [
    {
      "dot": "cyan",
      "title": "S1：最终验收",
      "items": [
        "官方 runner 逐例将路径追加到 solver 命令；默认 full 生成完整答案。",
        "grader 判断依赖、资源和内存是否合法并计算 Time。"
      ]
    },
    {
      "dot": "violet",
      "title": "S2：可控诊断",
      "items": [
        "--mode 选择阶段；--force-p 限定 P；--retime-mode 选择 auto / wide。",
        "--polish-pass-limit 限制 full 的局部扩展次数，0 仍受时间预算约束。"
      ]
    },
    {
      "dot": "amber",
      "title": "S3：提前退出与失败",
      "items": [
        "--help / -h 无需等待 stdin；未知选项、错误输入与无可行配置以错误码 2 退出。",
        "TO 来自 runner 外部超时；ERROR 来自进程错误；INVALID 来自答案判定。"
      ]
    }
  ]
