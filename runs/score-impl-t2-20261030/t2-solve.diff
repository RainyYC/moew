+def _seg_len(durations, group) -> int:
+    """一个卡组的段长 ``seg_v = max(ΣC_v, ΣWc_v)``（``lb = nmb × max_v seg_v``）。"""
+    compute = 0
+    comm = 0
+    for layer in group:
+        row = durations[layer]
+        compute += sum(row[i] for i in COMP_OPS)
+        comm += sum(row[i] for i in COMM_OPS)
+    return max(compute, comm)
